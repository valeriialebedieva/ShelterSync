@model List<ShelterSync.Models.Pet>

@{
    ViewData["Title"] = "Available Pets";
    var count = Model?.Count ?? 0;
}

<div class="container py-4">
    <section class="page-hero mb-4">
        <div class="page-hero__inner">
            <div class="row align-items-end">
                <div class="col-lg-8">
                    <span class="page-hero__eyebrow">Our Shelter</span>
                    <h1>Available for adoption</h1>
                    <p>Wonderful pets waiting to meet their forever families.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Pet" asp-action="Create" class="btn btn-primary">
                            + Add New Pet
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <div class="row mb-4">
        <div class="col-md-7 col-lg-5">
            <form asp-controller="Pet" asp-action="Index" method="get" class="search-bar">
                <input type="text" name="searchString" class="form-control flex-grow-1"
                       placeholder="Search by pet name…" value="@ViewBag.CurrentFilter" />
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>
    </div>

    @if (Model != null && count > 0)
    {
        <div class="section-heading">
            <h2>All pets</h2>
            <span class="text-muted small">@count listed</span>
        </div>

        <div class="row pet-grid">
            @foreach (var pet in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <article class="pet-card">
                        <div class="pet-card__media">
                            @if (pet.IsPetOfTheWeek)
                            {
                                <span class="pet-of-week">⭐ Pet of the Week</span>
                            }
                            @if (!string.IsNullOrEmpty(pet.ImagePath))
                            {
                                <img src="@pet.ImagePath" alt="@pet.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="pet-card__placeholder">🐾</div>
                            }
                        </div>
                        <div class="pet-card__body">
                            <h2 class="pet-card__title">@pet.Name</h2>
                            <div class="pet-card__meta">
                                <span class="badge badge-species">@pet.Species</span>
                                @if (!string.IsNullOrEmpty(pet.Breed))
                                {
                                    <span class="badge badge-breed">@pet.Breed</span>
                                }
                            </div>
                            @if (pet.Age > 0)
                            {
                                <p class="small text-muted mb-0">@pet.Age year@(pet.Age != 1 ? "s" : "") old</p>
                            }
                            @if (!string.IsNullOrEmpty(pet.Notes))
                            {
                                <p class="pet-card__notes">@pet.Notes</p>
                            }
                            @if (pet.IsAdopted)
                            {
                                <div class="alert alert-warning py-2 px-3 mb-0 small">Already adopted</div>
                            }
                        </div>
                        <div class="pet-card__footer">
                            <div class="d-flex gap-2">
                                <a asp-controller="Adoption" asp-action="Submit" asp-route-petId="@pet.Id"
                                   class="btn btn-sm btn-primary flex-grow-1">
                                    Request Adoption
                                </a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-controller="Pet" asp-action="Edit" asp-route-id="@pet.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Pet" asp-action="Delete" asp-route-id="@pet.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login"
                                       class="btn btn-sm btn-outline-primary">Sign in</a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">🔍</div>
            <h5>No pets found</h5>
            <p class="text-muted mb-4">There are currently no pets matching your search.</p>
            <a asp-controller="Pet" asp-action="Create" class="btn btn-primary">Add First Pet</a>
        </div>
    }
</div>
