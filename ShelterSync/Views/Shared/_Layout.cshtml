<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ShelterSync - Pet adoption management system helping shelters connect with perfect matches" />
    <meta name="theme-color" content="#2bb8a3" />
    <title>@ViewData["Title"] - ShelterSync</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShelterSync.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg" role="navigation" aria-label="Main navigation">
            <div class="container-fluid px-md-5">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="ShelterSync Home">
                    <span class="brand-icon" aria-hidden="true">🐾</span>
                    ShelterSync
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pet" asp-action="Index">Pets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="WhyAdopt">Why Adopt?</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-lg-2">
                                <span class="user-pill">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-nav btn-nav-ghost btn-sm">Sign Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-nav btn-nav-primary btn-sm" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container-fluid px-md-5">
            <div class="row align-items-start">
                <div class="col-md-6 mb-4 mb-md-0">
                    <div class="footer-brand">
                        <span class="brand-icon" style="width:2rem;height:2rem;font-size:0.95rem;">🐾</span>
                        <h6 class="mb-0">ShelterSync</h6>
                    </div>
                    <p class="text-muted small mb-0">Connecting pets with loving homes since 2026.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="small mb-2">
                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                        <span class="mx-2 opacity-50">·</span>
                        <a asp-controller="Home" asp-action="Contact">Contact Us</a>
                    </p>
                    <p class="text-muted small mb-0">&copy; 2026 ShelterSync. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
