@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="auth-card">
        <div class="auth-card__header">
            <div class="auth-card__icon">🔐</div>
            <h1>Welcome back</h1>
            <p>Sign in to manage shelter pets</p>
        </div>

        <div class="alert alert-info py-2 px-3 mb-4" role="alert">
            <small><strong>Demo:</strong> Any username + password (6+ chars). Use <code>admin</code> for admin access.</small>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 mb-3" role="alert">
                <div asp-validation-summary="All" class="small mb-0"></div>
            </div>
        }

        <form method="post" asp-action="Login">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" name="username" id="username" class="form-control"
                       placeholder="your.username" required autofocus>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" id="password" class="form-control"
                       placeholder="••••••••" required minlength="6">
            </div>

            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl">

            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">← Back to Home</a>
        </p>
    </div>
</div>
