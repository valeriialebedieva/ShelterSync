@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4">
    <section class="page-header">
        <span class="section-label">Your information matters</span>
        <h1>Privacy Policy</h1>
        <p>We care about keeping ShelterSync simple, respectful, and transparent for adopters, shelters, and volunteers.</p>
    </section>

    <div class="row g-4">
        <div class="col-lg-4 col-md-6">
            <article class="card h-100">
                <div class="card-body">
                    <h2 class="h5">What we collect</h2>
                    <p class="text-muted mb-0">ShelterSync may collect basic information you provide, such as your name, contact details, adoption requests, and pet preferences.</p>
                </div>
            </article>
        </div>
        <div class="col-lg-4 col-md-6">
            <article class="card h-100">
                <div class="card-body">
                    <h2 class="h5">How we use it</h2>
                    <p class="text-muted mb-0">We use information to help shelters manage pets, review adoption interest, respond to requests, and improve the adoption experience.</p>
                </div>
            </article>
        </div>
        <div class="col-lg-4 col-md-6">
            <article class="card h-100">
                <div class="card-body">
                    <h2 class="h5">How we protect it</h2>
                    <p class="text-muted mb-0">We aim to keep personal information limited, organized, and accessible only to people who need it for shelter operations.</p>
                </div>
            </article>
        </div>
    </div>

    <section class="card mt-4">
        <div class="card-body">
            <h2 class="h5">A practical note</h2>
            <p class="text-muted mb-0">This page is a general privacy overview for ShelterSync. As the project grows, this policy may be updated to describe new features, contact options, and data practices more clearly.</p>
        </div>
    </section>
</div>
